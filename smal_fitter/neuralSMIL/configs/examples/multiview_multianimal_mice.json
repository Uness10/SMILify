{
  "_doc": "Multi-view MULTI-ANIMAL training config: two mice per clip, one parameter head per mouse. Pairs with an HDF5 written in the multi-animal layout (see smal_fitter/neuralSMIL/multianimal/hdf5_schema.py): every animal-level dataset carries an animal axis after the sample axis, and metadata declares multianimal_schema_version / num_animals / specimen_ids. Head i is permanently bound to specimen i (specimen_ids below must match the dataset's track order), so there is no Hungarian matching and no permutation-invariant loss. Cameras stay scene/view level and are supervised once per sample, not once per mouse. Start from a trained single-animal checkpoint via training.resume_checkpoint: its head is copied into every specimen head (init_heads_from_single_animal).",
  "mode": "multiview",
  "multi_animal": {
    "_doc": "N known specimens per sample. Set enabled=false to fall back to the single-animal model.",
    "enabled": true,
    "num_animals": 2,
    "specimen_ids": [
      "mouse_a",
      "mouse_b"
    ],
    "head_strategy": "replicated",
    "tie_head_init": true,
    "init_heads_from_single_animal": true,
    "camera_mode": "scene_head",
    "scene_camera_hidden_dim": 256,
    "loss_reduction": "mean",
    "per_specimen_lr_scale": null,
    "require_stable_identity": true,
    "min_visible_keypoints_per_specimen": 4,
    "drop_absent_specimen_loss": true
  },
  "num_views_to_use": null,
  "min_views_per_sample": 2,
  "cross_attention_layers": 2,
  "cross_attention_heads": 8,
  "cross_attention_dropout": 0.1,
  "smal_model": {
    "smal_file": "3D_model_prep/SMILy_Mouse_static_joints_Falkner_conv_repose_hind_legs.pkl",
    "shape_family": null
  },
  "dataset": {
    "data_path": "multianimal_multiview_mice.h5",
    "train_ratio": 0.85,
    "val_ratio": 0.05,
    "test_ratio": 0.1,
    "dataset_fraction": 1.0
  },
  "model": {
    "backbone_name": "vit_large_patch16_224",
    "freeze_backbone": false,
    "backbone_unfreeze_epoch": null,
    "backbone_lr_multiplier": 0.1,
    "hidden_dim": 1024,
    "head_type": "transformer_decoder",
    "use_unity_prior": false,
    "use_ue_scaling": false,
    "rgb_only": true,
    "transformer_depth": 4,
    "transformer_heads": 8,
    "transformer_dim_head": 64,
    "transformer_mlp_dim": 1024,
    "transformer_dropout": 0.1,
    "transformer_ief_iters": 1,
    "transformer_trans_scale_factor": 1
  },
  "optimizer": {
    "learning_rate": 5e-05,
    "weight_decay": 0.0001,
    "gradient_clip_norm": 1.0,
    "optimizer_type": "adamw",
    "lr_schedule": {
      "0": 5e-05,
      "10": 3e-05,
      "20": 2e-05,
      "60": 1e-05,
      "100": 2e-06,
      "200": 1e-06
    }
  },
  "loss_curriculum": {
    "base_weights": {
      "global_rot": 0.0,
      "joint_rot": 0.001,
      "betas": 0.0005,
      "trans": 0.001,
      "fov": 0.001,
      "cam_rot": 0.01,
      "cam_trans": 0.01,
      "log_beta_scales": 0.0005,
      "betas_trans": 0.0005,
      "keypoint_2d": 0.1,
      "keypoint_3d": 0.25,
      "silhouette": 0.0,
      "joint_angle_regularization": 0.001,
      "limb_scale_regularization": 0.01,
      "limb_trans_regularization": 1,
      "triangulation_consistency": 0.0,
      "ief_intermediate": 0.0
    },
    "curriculum_stages": {
      "1": {
        "joint_angle_regularization": 0.01,
        "limb_scale_regularization": 0.1,
        "limb_trans_regularization": 1
      },
      "10": {
        "keypoint_2d": 0.1,
        "joint_angle_regularization": 1e-05,
        "limb_scale_regularization": 0.01,
        "limb_trans_regularization": 1
      },
      "20": {
        "keypoint_3d": 2,
        "joint_angle_regularization": 1e-06,
        "limb_scale_regularization": 0.001,
        "limb_trans_regularization": 0.5
      },
      "50": {
        "keypoint_3d": 2,
        "joint_angle_regularization": 1e-06,
        "limb_scale_regularization": 1e-05,
        "limb_trans_regularization": 0.5
      },
      "100": {
        "keypoint_3d": 2,
        "joint_angle_regularization": 1e-07,
        "limb_scale_regularization": 5e-06,
        "limb_trans_regularization": 0.0001
      },
      "150": {
        "keypoint_3d": 2,
        "joint_angle_regularization": 1e-07,
        "limb_scale_regularization": 1e-06,
        "limb_trans_regularization": 0.0001,
        "fov": 1e-07,
        "cam_rot": 1e-08,
        "cam_trans": 1e-08
      },
      "200": {
        "keypoint_3d": 2,
        "joint_angle_regularization": 1e-07,
        "limb_scale_regularization": 1e-06,
        "limb_trans_regularization": 1e-05,
        "fov": 1e-07,
        "cam_rot": 1e-08,
        "cam_trans": 1e-08
      }
    }
  },
  "scale_trans_beta": {
    "mode": "separate"
  },
  "mesh_scaling": {
    "allow_mesh_scaling": false,
    "init_mesh_scale": 1.0,
    "use_log_scale": true
  },
  "augmentation": {
    "enabled": true,
    "geometric_enabled": false,
    "color_jitter_brightness": 0.2,
    "color_jitter_contrast": 0.2,
    "color_jitter_saturation": 0.15,
    "gaussian_noise_std": 0.015,
    "gaussian_blur_prob": 0.3,
    "gaussian_blur_kernel_range": [
      3,
      7
    ],
    "random_erasing_prob": 0.2,
    "random_erasing_scale_range": [
      0.02,
      0.1
    ],
    "crop_jitter_fraction": 0.0,
    "scale_jitter_range": [
      0.9,
      1.1
    ]
  },
  "joint_importance": {
    "enabled": true,
    "important_joint_names": [
      "Nose",
      "paw_L_tip",
      "paw_R_tip",
      "Foot_L_tip",
      "Foot_R_tip",
      "Tail_07"
    ],
    "weight_multiplier": 10.0
  },
  "ignored_joint_locations": {
    "enabled": true,
    "ignored_joint_names": []
  },
  "output": {
    "checkpoint_dir": "checkpoints_multianimal_multiview_mice",
    "plots_dir": "plots_multianimal_multiview_mice",
    "visualizations_dir": "visualizations_multianimal_multiview_mice",
    "singleview_visualizations_dir": "singleview_renders_multianimal_multiview_mice",
    "save_checkpoint_every": 10,
    "generate_visualizations_every": 5,
    "plot_history_every": 5,
    "num_visualization_samples": 2
  },
  "training": {
    "batch_size": 2,
    "num_epochs": 300,
    "seed": 42,
    "rotation_representation": "6d",
    "num_workers": 8,
    "pin_memory": true,
    "prefetch_factor": 4,
    "resume_checkpoint": null,
    "reset_ief_token_embedding": false,
    "use_gt_camera_init": true,
    "use_mixed_precision": false,
    "backbone_chunk_size": 6,
    "gradient_accumulation_steps": 1
  }
}
